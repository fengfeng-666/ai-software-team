/* 结果页样式 */
.status-header {
  text-align: center;
  padding: 40rpx 30rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.status-header.success {
  background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
}

.status-header.error {
  background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
}

.status-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.status-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.status-desc {
  font-size: 26rpx;
  color: #666;
}

/* 时间线 */
.timeline {
  padding-left: 30rpx;
}

.timeline-item {
  position: relative;
  padding-bottom: 30rpx;
  padding-left: 40rpx;
  border-left: 2rpx solid #e0e0e0;
}

.timeline-item:last-child {
  border-left: none;
  padding-bottom: 0;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: -8rpx;
  top: 8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #e0e0e0;
  border: 2rpx solid #fff;
}

.timeline-item.completed::before {
  background: #4CAF50;
  border-color: #4CAF50;
}

.timeline-dot {
  position: absolute;
  left: -12rpx;
  top: 4rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #4A90E2;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
  display: none;
}

.timeline-item.completed .timeline-dot {
  display: block;
}

.timeline-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.timeline-desc {
  font-size: 24rpx;
  color: #999;
}

/* 对话记录 */
.conversations {
  max-height: 600rpx;
  overflow-y: auto;
}

.conversation-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.conversation-item:last-child {
  border-bottom: none;
}

.conv-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.conv-avatar {
  width: 48rpx;
  height: 48rpx;
  font-size: 32rpx;
  margin-right: 12rpx;
}

.conv-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-right: 12rpx;
}

.conv-role {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.conv-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  word-break: break-all;
}

/* 代码块 */
.code-block {
  background: #1e1e1e;
  border-radius: 12rpx;
  overflow: hidden;
}

.code-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #2d2d2d;
  color: #fff;
  font-size: 24rpx;
}

.copy-btn {
  background: #4A90E2;
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.code-scroll {
  padding: 20rpx;
  max-height: 400rpx;
}

.code-content {
  font-family: 'Courier New', Courier, monospace;
  font-size: 24rpx;
  color: #d4d4d4;
  line-height: 1.5;
  white-space: pre;
}

/* 审查意见 */
.review-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  word-break: break-all;
}

/* 操作按钮 */
.action-section {
  margin-top: 40rpx;
  padding-bottom: 60rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
  text-align: center;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 226, 0.3);
  margin-bottom: 20rpx;
}

.btn-secondary {
  background: #fff;
  color: #4A90E2;
  border: 2rpx solid #4A90E2;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
  text-align: center;
}
