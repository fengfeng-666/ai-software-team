/* 首页样式 */
.header {
  text-align: center;
  padding: 40rpx 0 30rpx;
}

.logo {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.task-link {
  font-size: 26rpx;
  color: #4A90E2;
  padding: 8rpx 24rpx;
  background: #E3F2FD;
  border-radius: 24rpx;
  display: inline-block;
}

/* 团队成员 */
.team-members {
  display: flex;
  justify-content: space-around;
}

.member {
  text-align: center;
  flex: 1;
}

.member-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.member-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.member-desc {
  font-size: 20rpx;
  color: #999;
}

/* 表单样式 */
.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.form-input {
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  transition: border-color 0.3s;
}

.form-input:focus {
  border-color: #4A90E2;
  background: #fff;
}

.form-textarea {
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  min-height: 200rpx;
  width: 100%;
  box-sizing: border-box;
  transition: border-color 0.3s;
}

.form-textarea.small {
  min-height: 120rpx;
}

.form-textarea:focus {
  border-color: #4A90E2;
  background: #fff;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 标签选择 */
.type-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  background: #f0f2f5;
  border: 2rpx solid #e9ecef;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s;
}

.tag.active {
  background: #e8f2ff;
  border-color: #4A90E2;
  color: #4A90E2;
}

/* 提交区域 */
.submit-section {
  margin-top: 20rpx;
  padding-bottom: 40rpx;
}

.submit-btn {
  height: 96rpx;
  line-height: 96rpx;
}

.submit-btn[disabled] {
  background: linear-gradient(135deg, #ccc 0%, #aaa 100%);
  box-shadow: none;
}

.tip {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 进度卡片 */
.progress-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.progress-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.progress-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.progress-title {
  font-size: 36rpx;
  font-weight: 600;
}

.progress-bar-container {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #ffd700 0%, #ff6b6b 100%);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.progress-text {
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.progress-step {
  display: flex;
  justify-content: space-between;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
}

.step-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

.step-dot.active {
  background: #ffd700;
  border-color: #ffd700;
  box-shadow: 0 0 8rpx rgba(255, 215, 0, 0.5);
}

.progress-desc {
  font-size: 28rpx;
  text-align: center;
  margin-bottom: 24rpx;
  opacity: 0.9;
}

.btn-cancel {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 16rpx 0;
}
