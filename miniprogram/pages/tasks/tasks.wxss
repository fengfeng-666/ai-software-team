/* 任务列表页样式 */
.header {
  padding: 30rpx 0;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
}

/* 刷新栏 */
.refresh-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.task-count {
  font-size: 26rpx;
  color: #666;
}

.refresh-btn {
  font-size: 26rpx;
  color: #4A90E2;
  padding: 8rpx 16rpx;
}

/* 加载和空状态 */
.loading, .empty {
  text-align: center;
  padding: 80rpx 0;
}

.loading-icon, .empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.loading-text, .empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 30rpx;
}

/* 任务列表 */
.task-list {
  padding-bottom: 40rpx;
}

.task-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.task-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
}

.task-card.pending::before {
  background: #FFC107;
}

.task-card.running::before {
  background: #2196F3;
}

.task-card.completed::before {
  background: #4CAF50;
}

.task-card.failed::before {
  background: #F44336;
}

/* 状态标识 */
.task-status-badge {
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

/* 任务信息 */
.task-info {
  flex: 1;
  min-width: 0;
}

.task-id {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.task-step {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 进度条 */
.task-progress {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-bar-bg {
  flex: 1;
  height: 12rpx;
  background: #E0E0E0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-right: 12rpx;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #2196F3 0%, #1976D2 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 22rpx;
  color: #2196F3;
  font-weight: 600;
  flex-shrink: 0;
}

/* 元信息 */
.task-meta {
  display: flex;
  gap: 16rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #999;
}

/* 操作按钮 */
.task-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.action-btn {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  text-align: center;
}

.action-btn.view {
  background: #E3F2FD;
  color: #2196F3;
}

.action-btn.delete {
  background: #FFEBEE;
  color: #F44336;
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  border: none;
  width: 300rpx;
}
